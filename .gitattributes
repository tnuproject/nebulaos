# Auto detect text files and perform LF normalization for Linux OS compatibility
* text=auto eol=lf

# Explicit bash scripts and shell configurations must always use LF
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.desktop text eol=lf
*.service text eol=lf
*.override text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.ico binary
*.iso binary
*.deb binary
*.tar.gz binary
